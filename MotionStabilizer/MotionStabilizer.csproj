<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MotionStabilizer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>MotionStabilizer</RootNamespace>
    <Version>2.3.0</Version>
    <Company>3D Motion Stabilizer</Company>
    <Product>Motion Stabilizer</Product>
    <Description>Safe, zero-intrusion visual stabilization overlay for 3D game motion sickness relief</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
