    <!-- Motion Dots -->
    <sys:String x:Key="Motion_SettingsCard">Motion Dots Settings</sys:String>
    <sys:String x:Key="Motion_Desc">Displays dynamic dots on both sides of the screen that respond to mouse movement, providing visual motion anchors. GPU usage occurs while active.</sys:String>
    <sys:String x:Key="Motion_KeyboardEnable">Enable keyboard WASD to control motion dots (do not use in online games)</sys:String>
    <sys:String x:Key="Motion_GamepadEnable">Enable gamepad control of motion dots (do not use in online games)</sys:String>
    <sys:String x:Key="Motion_InvertDirection">Invert motion direction (mouse, keyboard and gamepad reversed)</sys:String>
    <sys:String x:Key="Motion_ParallaxScale">Parallax scale (dots shrink near screen center)</sys:String>
    <sys:String x:Key="Motion_ParallaxAmount">Dot Scale Amount</sys:String>
    <sys:String x:Key="Motion_DotColumns">Dot Columns</sys:String>
    <sys:String x:Key="Motion_DotSpacingV">Vertical Spacing</sys:String>
    <sys:String x:Key="Motion_DotSpacingH">Horizontal Spacing</sys:String>
    <sys:String x:Key="Motion_MouseSensitivity">Mouse &amp; Gamepad Turning</sys:String>
    <sys:String x:Key="Motion_KeyboardSensitivity">Keyboard Movement</sys:String>
    <sys:String x:Key="Motion_GamepadSensitivity">Gamepad Movement</sys:String>
    <sys:String x:Key="Motion_GamepadDeadzone">Stick Deadzone</sys:String>
    <sys:String x:Key="Motion_RefreshRate">Refresh Rate</sys:String>
    <sys:String x:Key="Motion_WarningTitle">⚠ Safety Warning — Ban Risk</sys:String>
    <sys:String x:Key="Motion_WarningMsg">Enabling this feature uses high-frequency key polling (GetAsyncKeyState). It is strictly prohibited to use in multiplayer games with Vanguard, EAC, BattlEye or other anti-cheat systems — it may result in a ban. Only enable for single-player games!\n\nDo you wish to continue?</sys:String>
    <sys:String x:Key="Motion_WarningYes">I understand the risk, enable</sys:String>
    <sys:String x:Key="Motion_WarningNo">Cancel</sys:String>
    <sys:String x:Key="Motion_WarnDontShowAgain">Don't show this warning again (the enable state still resets on restart)</sys:String>
    <sys:String x:Key="Motion_GamepadNotFound_Title">No Gamepad Detected</sys:String>
    <sys:String x:Key="Motion_GamepadNotFound_Msg">Gamepad control is enabled, but no connected XInput gamepad was detected.\n\nXbox controllers work out of the box; other pads (DualSense, Switch Pro, etc.) must be converted to be recognized: enable "Controller → Xbox Configuration Support" in Steam, or use a tool like BetterJoy and enable the controller there.\n\nVirtual gamepads created by conversion tools must likewise never be used in online games. Once a gamepad is connected, the motion dots respond to its sticks immediately — no restart needed.</sys:String>
    <sys:String x:Key="Motion_XInputUnavailable_Title">XInput Unavailable</sys:String>
    <sys:String x:Key="Motion_XInputUnavailable_Msg">Gamepad control is enabled, but this machine is missing the XInput components (xinput1_4.dll / xinput9_1_0.dll), so gamepad state cannot be read. These ship with Windows and are normally present; if this persists, please verify system integrity.\n\nAll other overlay features are unaffected.</sys:String>
    <sys:String x:Key="Motion_GamepadWarningMsg">Enabling this feature polls XInput gamepad stick state (left stick = keyboard role, right stick = mouse role). Stick polling is a passive read that injects no input into the system, but for policy consistency it must never be used in multiplayer games with Vanguard, EAC, BattlEye or other anti-cheat systems. Only enable for single-player games!\n\nDo you wish to continue?</sys:String>
    <sys:String x:Key="Motion_InitFail_Title">Motion Dots Unavailable</sys:String>
    <sys:String x:Key="Motion_InitFail_Msg">Motion dots rendering could not be initialized (a Direct3D 11 capable GPU driver is required). This can happen over remote desktop, in virtual machines, or with outdated GPU drivers. Other overlay features are unaffected.</sys:String>

