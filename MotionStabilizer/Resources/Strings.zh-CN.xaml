    <sys:String x:Key="Motion_GamepadEnable">启用手柄控制动态圆点（禁止联机游戏使用）</sys:String>
    <sys:String x:Key="Motion_InvertDirection">反转运动方向（鼠标、键盘和手柄控制反向）</sys:String>
    <sys:String x:Key="Motion_ParallaxScale">视差缩放（圆点靠近屏幕中线时自动缩小）</sys:String>
